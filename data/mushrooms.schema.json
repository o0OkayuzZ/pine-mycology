{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Pinene Mycology authoring registry (project schema, not Mojang's)",
 "type":"object",
 "required":["schemaVersion","release","warningJa","mushrooms"],
 "properties":{
  "schemaVersion":{"const":1},
  "release":{"type":"string"},
  "warningJa":{"type":"string","minLength":20},
  "mushrooms":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/mushroom"}}
 },
 "$defs":{
  "effect":{"type":"object","required":["effect","level","seconds"],"additionalProperties":false,"properties":{"effect":{"enum":["regeneration","darkness","nausea","haste","hunger","speed","jump_boost","resistance","slowness","strength","weakness","mining_fatigue","absorption","fatal_poison","poison","wither","night_vision","slow_falling"]},"level":{"type":"integer","minimum":1,"maximum":255},"seconds":{"type":"number","exclusiveMinimum":0,"maximum":3600}}},
  "mushroom":{"type":"object","required":["id","indexInGroup","group","itemId","nameJa","scientificName","rarity","textureKey","texturePath","useMode","realWorldStatus","food","cooldownSeconds","effects","special","scienceJa","gameExplanationJa","jokeJa","sourceIds"],"properties":{
   "id":{"type":"string","pattern":"^[RB][0-9]{2,}$"},"indexInGroup":{"type":"integer","minimum":0},"group":{"enum":["red","brown"]},"itemId":{"type":"string","pattern":"^pinene:[a-z0-9_]+$"},"nameJa":{"type":"string","minLength":1},"scientificName":{"type":"string","minLength":1},"rarity":{"type":"integer","minimum":1,"maximum":10},"useMode":{"enum":["eat","crush","specimen"]},"realWorldStatus":{"enum":["food_recorded","toxic","unknown","conditional","inedible"]},"effects":{"type":"array","items":{"$ref":"#/$defs/effect"}},"cooldownSeconds":{"type":"number","minimum":0},"sourceIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
   "food":{"oneOf":[{"type":"null"},{"type":"object","required":["nutrition","saturationModifier","alwaysEat","useSeconds"],"properties":{"nutrition":{"type":"integer","minimum":0,"maximum":20},"saturationModifier":{"type":"number","minimum":0,"maximum":20},"alwaysEat":{"type":"boolean"},"useSeconds":{"type":"number","exclusiveMinimum":0}}}]},
   "special":{"oneOf":[{"type":"null"},{"type":"object","required":["kind"],"properties":{"kind":{"enum":["damage_first","choice","sense","delayed","spore_burst"]},"effects":{"type":"array","items":{"$ref":"#/$defs/effect"}},"delaySeconds":{"type":"number","exclusiveMinimum":0},"radius":{"type":"number","exclusiveMinimum":0},"maxEntities":{"type":"integer","minimum":1,"maximum":64}}}]}
  },"allOf":[{"if":{"properties":{"useMode":{"const":"eat"}}},"then":{"properties":{"food":{"type":"object"}}},"else":{"properties":{"food":{"type":"null"}}}}]}
 }
}
